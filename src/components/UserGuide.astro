---
<div class="guide-grid" role="region" aria-label="How it works: four steps" tabindex="0">
    <div class="guide-step">
        <img class="guide-number" src="/images/guide-number-1.png" alt="Step 1" width="215" height="215" />
        <img class="guide-art" src="/images/loqrs-guide-step-1.png" alt="Monitor and phone showing a QR locker" width="275" height="203" />
        <h4>Check out a QR locker</h4>
        <h3 class="carousel-instruction">← Swipe</h3>
    </div>
    <div class="guide-step">
        <img class="guide-number" src="/images/guide-number-2.png" alt="Step 2" width="215" height="215" />
        <img class="guide-art" src="/images/loqrs-guide-step-2.png" alt="Files placed into an open locker" width="300" height="346" />
        <h4>Place your files in your locker</h4>
    </div>
    <div class="guide-step">
        <img class="guide-number" src="/images/guide-number-3.png" alt="Step 3" width="215" height="215" />
        <img class="guide-art" src="/images/loqrs-guide-step-3.png" alt="Locked locker with a QR key to keep or share" width="320" height="254" />
        <h4>Receive your QR encryption key</h4>
    </div>
    <div class="guide-step">
        <img class="guide-number" src="/images/guide-number-4.png" alt="Step 4" width="215" height="215" />
        <img class="guide-art" src="/images/loqrs-guide-step-4.png" alt="Phone scanning a QR key to unlock" width="320" height="206" />
        <h4>Scan the QR key and gain access</h4>
    </div>
    <div class="guide-step final">
        <h1>That is all.</h1>
        <h3>No Accounts!</h3>
        <h3>No Passwords!</h3>
        <p>Encrypted file transfer without hastle—just a key.</p>
    </div>
</div>

<style lang="scss">
@use '../styles/variables' as *;

.guide-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 2rem;
    max-width: 1442px;
    padding: 1rem;
    margin: 0 auto;
}

.guide-grid:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}

.guide-step {
    flex: 1 1 260px;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;

    .guide-number {
        width: 100%;
        max-width: 75px;
    }

    .guide-art {
        width: 100%;
        max-width: 320px;
        height: 240px;
        object-fit: contain;
    }

    h4 {
        margin: 0;
        text-align: center;
    }

    .carousel-instruction {
        color: $locker-orange;
        display: none;
    }
}

.guide-step.final {
    display: block;
    margin: 2rem 0;
    h1 {
        font-size: 5rem;
        line-height: 4.2rem;
        color: $locker-orange;
    }
    h3 {
        font-size: 2rem;
        margin-top: 2rem;
    }
    h1, h2, h3, p {
        padding: 0;
        margin: 0;
    }
    @media (max-width: 40rem) {
        h3 {
            font-size: 2.4rem;
            margin-top: 2rem;
        }
        p {
            font-size: 1.8rem;
            line-height: 2rem;
            margin-top: 2rem;
        }
    }
}

/* Below 40rem the wrapped grid becomes a swipeable carousel. This is native
   horizontal scrolling with snap points: no JavaScript, no dots, no buttons.
   The scroll position is the only state, so a swipe is the entire interaction.
   A sliver of the next step stays visible as the affordance that more exist. */
@media (max-width: 40rem) {
    .guide-grid {
        flex-wrap: nowrap;
        justify-content: flex-start;
        gap: 1rem;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: 1rem;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;

        .carousel-instruction {
            display: block;
        }
    }

    .guide-grid::-webkit-scrollbar {
        display: none;
    }

    .guide-step {
        /* Width, not flex-basis: the slide must not grow to fill the viewport,
           or there would be no peek and no snap travel. */
        flex: 0 0 auto;
        width: min(90vw, 380px);
        scroll-snap-align: start;
        scroll-snap-stop: always;
    }
}
</style>
